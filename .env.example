# LLM Evaluation Framework — Environment Configuration
# Author: Prudhvi Balla (prudhviballa03@gmail.com)
# Copy this file to .env and insert your API keys if using cloud providers.

# Default Provider: "mock" (offline zero-setup), "ollama" (local free), "openai", "gemini", or "anthropic"
DEFAULT_PROVIDER=mock

# Local Ollama URL (Default: http://localhost:11434/api/generate)
OLLAMA_BASE_URL=http://localhost:11434/api/generate

# Cloud Providers (Optional)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Observability (Optional - Phase 5)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
